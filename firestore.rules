rules_version = '2';

// Tidy Tribe security rules.
// Adults (shaun, lyndsey, heidi) can change everything.
// Kids (alex, emma) can only: tick/untick their own chores (points must match the chore),
// request rewards or cash outs for themselves, cancel their own pending requests,
// pass on a take-turns chore by doing it, and choose their own colour. They can never change points directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function me() {
      return request.auth.token.email.lower().split('@')[0];
    }
    function onDomain() {
      return request.auth.token.email.lower().matches('^[a-z]+@tidytribe[.]app$');
    }
    function isAdult() {
      return signedIn() && onDomain() && me() in ['shaun', 'lyndsey', 'heidi'];
    }
    function isKid() {
      return signedIn() && onDomain() && me() in ['alex', 'emma'];
    }
    function isMember() {
      return isAdult() || isKid();
    }
    function docPath(col, id) {
      return /databases/$(database)/documents/$(col)/$(id);
    }

    match /config/{id} {
      allow read: if isMember();
      allow write: if isAdult();
    }
    match /chores/{id} {
      allow read: if isMember();
      allow write: if isAdult();
    }
    match /rewards/{id} {
      allow read: if isMember();
      allow write: if isAdult();
    }
    match /stars/{id} {
      allow read: if isMember();
      allow write: if isAdult();
    }
    match /adjustments/{id} {
      allow read: if isMember();
      allow write: if isAdult();
    }

    // Take-turns chores (bins): whose turn it is. A kid can pass the turn on only by doing
    // the chore, and take it back only by undoing that same tick.
    function turnPassOk(id) {
      let d = request.resource.data;
      let c = docPath('completions', d.lastCid);
      return d.keys().hasOnly(['kid', 'lastCid', 'prev'])
        && d.prev == me() && d.kid != me()
        && d.kid in get(docPath('chores', id)).data.kids
        && !exists(c) && existsAfter(c)
        && getAfter(c).data.kid == me() && getAfter(c).data.choreId == id
        && (resource == null || resource.data.kid == me());
    }
    function turnBackOk(id) {
      let d = request.resource.data;
      let c = docPath('completions', resource.data.lastCid);
      return d.keys().hasOnly(['kid', 'lastCid', 'prev'])
        && d.kid == me() && d.lastCid == resource.data.lastCid
        && exists(c) && !existsAfter(c)
        && get(c).data.kid == me() && get(c).data.choreId == id;
    }
    match /turns/{id} {
      allow read: if isMember();
      allow create: if isAdult() || (isKid() && turnPassOk(id));
      allow update: if isAdult() || (isKid() && (turnPassOk(id) || turnBackOk(id)));
      allow delete: if isAdult();
    }

    match /prefs/{kid} {
      allow read: if isMember();
      allow write: if isAdult()
        || (isKid() && kid == me() && request.resource.data.keys().hasOnly(['colour']));
    }

    // Points balances. A kid's balance can only move together with one of their own
    // chore ticks (up) or unticks (down), by exactly that chore's points.
    function kidBalanceOk(kid) {
      let d = request.resource.data;
      let o = resource.data;
      let c = docPath('completions', d.lastOp);
      let delta = d.points - o.points;
      return d.diff(o).affectedKeys().hasOnly(['points', 'lastOp'])
        && ((!exists(c) && existsAfter(c) && getAfter(c).data.kid == kid && getAfter(c).data.pts == delta)
          || (exists(c) && !existsAfter(c) && get(c).data.kid == kid && get(c).data.pts == -delta));
    }
    match /balances/{kid} {
      allow read: if isMember();
      allow create, delete: if isAdult();
      allow update: if isAdult() || (isKid() && kid == me() && kidBalanceOk(kid));
    }

    // Chore ticks. Document id is <kid>_<YYYY-MM-DD>_<choreId>, so a chore can only be ticked once a day.
    function kidCreateOk(cid) {
      let d = request.resource.data;
      let b = docPath('balances', me());
      return d.kid == me()
        && cid.matches('^' + me() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}_.+$')
        && d.pts == get(docPath('chores', d.choreId)).data.pts
        && (get(docPath('chores', d.choreId)).data.rotate != 'turns'
          || get(docPath('turns', d.choreId)).data.kid == me())
        && d.at is timestamp
        && d.at <= request.time + duration.value(5, 'm')
        && d.at > request.time - duration.value(36, 'h')
        && d.undoUntil is timestamp
        && d.undoUntil <= request.time + duration.value(1, 'd')
        && getAfter(b).data.points == get(b).data.points + d.pts;
    }
    function kidDeleteOk() {
      let b = docPath('balances', me());
      return resource.data.kid == me()
        && request.time < resource.data.undoUntil
        && getAfter(b).data.points == get(b).data.points - resource.data.pts;
    }
    match /completions/{cid} {
      allow read: if isMember();
      allow create: if isAdult() || (isKid() && kidCreateOk(cid));
      allow delete: if isAdult() || (isKid() && kidDeleteOk());
      allow update: if isAdult();
    }

    // Reward and cash-out requests. Only adults approve or decline.
    function kidRequestOk() {
      let d = request.resource.data;
      return d.kid == me() && d.status == 'pending'
        && ((d.type == 'reward' && d.pts == get(docPath('rewards', d.rewardId)).data.pts)
          || (d.type == 'cashout' && d.pts == get(docPath('config', 'main')).data.cashOutLot));
    }
    match /requests/{rid} {
      allow read: if isMember();
      allow create: if isAdult() || (isKid() && kidRequestOk());
      allow update: if isAdult()
        || (isKid() && resource.data.kid == me() && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt']));
      allow delete: if isAdult();
    }
  }
}
